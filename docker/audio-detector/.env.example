# Cheia API pentru endpoint-ul /predict (generați una puternică: openssl rand -hex 32)
API_KEY=change-me

# Model folosit (repo Hugging Face publicat)
MODEL_ID=Bgeorge/deepfake-audio-detector-wav2vec2
USE_LOCAL_WEIGHTS=false
# MODEL_PATH=/models/fine_tuned

# GPU Pascal vechi (Tesla P40): 1; GPU modern: 0
DISABLE_CUDNN=0

# Limita de dimensiune a upload-ului (MB)
MAX_UPLOAD_MB=20
