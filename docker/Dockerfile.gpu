FROM python:3.10-slim

# GPU-enabled image (requires nvidia-container-toolkit on the host).
# Build with: docker build -f Dockerfile.gpu -t deepdesk:gpu .

FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        git python3 python3-pip libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/deepdesk

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt \
    && pip3 install --no-cache-dir git+https://github.com/openai/CLIP.git

COPY app ./app

RUN mkdir -p /data/weights
ENV WEIGHTS_DIR=/data/weights

EXPOSE 7860

CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]
