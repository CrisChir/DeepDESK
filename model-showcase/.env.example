# ============================================================
# Showcase Hub — șablon de configurare
#   cp .env.example .env
# ============================================================

# ---- DeepDESK audio: cheia API obligatorie pentru POST /predict ----
# Generați una puternică: openssl rand -hex 32
DEEPDESK_AUDIO_API_KEY=change-me

# ---- GenD: token Hugging Face ----
# Necesar doar pentru modelul gated yermandy/GenD_DINOv3_L
HF_TOKEN=

# ---- Autentificare opțională pentru hub (dacă e expus public) ----
HUB_USER=
HUB_PASSWORD=

# ---- Backend-uri externe (lasați goale pentru rețeaua compose) ----
# DEEPDESK_IMAGES_URL=http://deepdesk-images-video:7860
# DEEPDESK_AUDIO_URL=http://deepdesk-audio:8000
# GEND_URL=http://gend-app:7860
# RPPG_URL=http://clinical-vitals-api:7861

# ---- Porturi publice (host) ----
# HUB_PORT=7870
# DEEPDESK_IMAGES_PORT=7860
# DEEPDESK_AUDIO_PORT=8000
# GEND_PORT=7862
# RPPG_API_PORT=7861

# ---- Timeout pentru analize lungi (secunde) ----
API_TIMEOUT_SECONDS=900
